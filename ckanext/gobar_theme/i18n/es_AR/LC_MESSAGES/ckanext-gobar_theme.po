msgid "No datasets found for \"{query}\""
msgstr "No se encontraron datasets para \"{query}\""

msgid "{number} dataset found"
msgid_plural "{number} datasets found"
msgstr[0] "{number} dataset encontrado"
msgstr[1] "{number} datasets encontrados"

msgid "No datasets found"
msgstr "No se encontraron datasets"

# --- Familia "group": /group se presenta como "Temas" en este portal ---
# EN SCOPE (etiquetas visibles de la UI de grupos: nav, listados, títulos,
#   botones, widget de asociación dataset<->grupo):
#   Groups, Group Form, Add Group, Edit Group, Create a Group, Create Group,
#   Update Group, Save Group, My Group, My Groups, Search groups...,
#   What are Groups?, Add to group, Associate this group with this dataset,
#   Remove dataset from this group, Datasets in group: {group},
#   There are no groups associated with this dataset,
#   There are currently no groups for this site,
#   A little information about my group..., los dos "delete group",
#   y el contador {number} group found (+plural, +for "{query}", +No groups).
# FUERA DE SCOPE (a propósito — NO tocar):
#   "Group" (singular suelto: validators.py/converters.py/views/group.py/stats,
#     riesgo colateral alto — puede deber quedar "Grupo"),
#   "Group name already exists in database", "Group not found",
#   "Group was not found.", "Group member has been deleted.",
#   "{number} groups have been purged", "There are no groups to purge"
#     (errores / flash / papelera de sysadmin),
#   "No groups" (label de ckanext-stats, no es la UI objetivo).
msgid "Groups"
msgstr "Temas"

